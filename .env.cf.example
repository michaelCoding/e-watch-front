# === Medusa Backend ===
NEXT_PUBLIC_MEDUSA_BACKEND_URL=https://<railway-backend-domain>
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=<from medusa admin → Settings → API Keys>

# === Search (optional) ===
NEXT_PUBLIC_SEARCH_ENDPOINT=https://<railway-meilisearch-public-url>
NEXT_PUBLIC_SEARCH_API_KEY=<meilisearch search-only key>

# === App URL ===
NEXT_PUBLIC_BASE_URL=https://<your-cloudflare-pages-domain>
